# MongoDB connection string (Atlas or local), for example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/meal-manager
MONGODB_URI=

# Random secret used to sign login cookies. Create one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Time zone used to decide what "today" is
APP_TIMEZONE=Asia/Dhaka

# The one admin account. Create or update it with: npm run create-admin
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

